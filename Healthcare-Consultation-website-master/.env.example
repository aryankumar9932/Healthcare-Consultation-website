# Copy to .env (never commit .env). Generate secrets with:  openssl rand -hex 32
NODE_ENV=production
SESSION_SECRET=
REPORT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
ML_SERVICE_KEY=
GEMINI_API_KEY=
# Local (non-Docker) PostgreSQL:
# DATABASE_URL=postgres://careconnect:password@localhost:5432/careconnect
# PGSSL=true            # managed databases (RDS, Supabase, Neon...)
# TRUST_PROXY=1         # behind one reverse proxy / load balancer
# Rate limits and lockout (defaults shown)
# RATE_LIMIT_API=600  RATE_LIMIT_AUTH=20  RATE_LIMIT_AI=60
# LOGIN_MAX_FAILURES=5  LOGIN_LOCK_MINUTES=15
