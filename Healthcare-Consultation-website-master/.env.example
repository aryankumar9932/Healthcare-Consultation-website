# Copy to .env (never commit .env). Generate secrets with:  openssl rand -hex 32
NODE_ENV=production
SESSION_SECRET=
REPORT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
ML_SERVICE_KEY=
GEMINI_API_KEY=
# Local (non-Docker) PostgreSQL:
# DATABASE_URL=postgres://careconnect:password@localhost:5432/careconnect
# PGSSL=true            # managed databases (RDS, Supabase, Neon...)
# TRUST_PROXY=1         # behind one reverse proxy / load balancer
# Rate limits and lockout (defaults shown)
# RATE_LIMIT_API=600  RATE_LIMIT_AUTH=20  RATE_LIMIT_AI=60
# LOGIN_MAX_FAILURES=5  LOGIN_LOCK_MINUTES=15
# Email (needed for confirmation + password reset links)
# APP_URL=https://care.example.com        # required in production; public address used in email links
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="CareConnect <no-reply@example.com>"
# REQUIRE_VERIFIED_EMAIL=true             # default: enforced whenever email can be delivered
# RATE_LIMIT_RESET=10  RATE_LIMIT_EMAIL=30
# Appointment reminders (disable with REMINDERS=off)
# REMINDERS=on
# Razorpay online consultation payments (use test keys during development)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_CURRENCY=INR
# Appointment cancellation refunds (full refund at/above threshold; partial below)
# REFUND_FULL_HOURS=24
# REFUND_PARTIAL_PERCENT=50
